# Server settings. On the server: cp .env.example .env, edit the values, chmod 600 .env
# .env is in .gitignore and never goes to GitHub (it holds the database password).

# --- App ---
APP_ENV=production
PORT=3000

# --- Domain and SSL ---
# Your DuckDNS domain:
DOMAIN=yourname.duckdns.org
# Certificate expiry warnings go here:
CERTBOT_EMAIL=you@example.com

# --- AWS ---
AWS_REGION=us-east-1
# Your ECR registry (account ID + region):
ECR_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com
ECR_REPOSITORY=streamlined-webapp

# --- Database (Amazon RDS PostgreSQL) ---
# RDS endpoint from the console:
DB_HOST=webapp-db.xxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=webapp
DB_USER=appadmin
# RDS master password (letters and numbers only):
DB_PASSWORD=change-me
# Path INSIDE the container to the RDS certificate bundle:
DB_SSL_CA=/app/certs/rds-global-bundle.pem
